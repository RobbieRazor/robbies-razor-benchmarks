{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naturepedia-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mcp.robbiegeorgephotography.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
