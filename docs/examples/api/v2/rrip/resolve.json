{
  "version": "2.0.0",
  "endpoint": "/api/v2/rrip/resolve",
  "endpointClass": "public-control-plane",
  "requiresPayment": false,

  "principle": "Recursive Registry Inheritance Principle",
  "abbreviation": "RRIP",

  "authority": {
    "framework": "Grand Compression",
    "masterReferenceDocument": "MRD v2.0",
    "canonicalIdentifier": "GC-MRD-v2.0",
    "canonicalRelationship": "MRD v2.0 §12.8",
    "canonicalClaimRange": "RC-01 through RC-22",
    "architectOfRecord": "Robbie George",
    "website": "https://www.robbiegeorgephotography.com"
  },

  "purpose": "Public machine-facing resolution of registered object identity, parent registry context, provenance, governance metadata, and available relationship context.",

  "primitive": [
    "compression",
    "expression",
    "memory",
    "recursion"
  ],

  "frameworkInterpretation": {
    "compression": "Structure may be reduced or organized while preserving information required for the declared purpose.",
    "expression": "Preserved structure may be represented through Plates, registries, or other declared interfaces.",
    "memory": "Relevant identity, relationships, provenance, constraints, or state may be preserved for later retrieval or reuse.",
    "recursion": "Preserved structure may be reused or transformed across subsequent processing cycles."
  },

  "registryArchitecture": {
    "plate": {
      "defined": true,
      "role": "Registered knowledge object or interface"
    },
    "registry": {
      "defined": true,
      "role": "Collection or routing context for registered objects"
    },
    "metaRegistry": {
      "defined": true,
      "instantiation": "resource-specific"
    },
    "graphRegistry": {
      "defined": true,
      "instantiation": "resource-specific"
    },
    "knowledgeMesh": {
      "defined": true,
      "instantiation": "resource-specific"
    }
  },

  "interpretationBoundary": {
    "plateDoesNotImplyMetaRegistry": true,
    "plateDoesNotImplyGraphRegistry": true,
    "plateDoesNotImplyKnowledgeMesh": true,
    "registryRelationshipDoesNotImplyCausation": true,
    "resolutionDoesNotImplyPayment": true,
    "resolutionDoesNotImplyProtectedResource": true,
    "resolutionDoesNotImplyEmpiricalValidation": true,
    "higherOrderLayersRequireExplicitImplementation": true
  },

  "resolutionMode": "registered-object-resolution",
  "supportedQueryParameter": "id",

  "queryEncoding": {
    "identifierFormat": "page-slug#plate-slug",
    "httpQueryRule": "Encode # as %23 when the identifier is supplied inside a URL query parameter.",
    "example": "/api/v2/rrip/resolve?id=willows-of-north-america%23willow-biodiversity-plate"
  },

  "resolutionProcess": [
    "Receive registered object identifier",
    "Resolve canonical registry entry",
    "Resolve directly declared parent context",
    "Resolve available relationships",
    "Resolve governance and provenance metadata",
    "Return public machine-readable resolution context"
  ],

  "retrievalRelationship": {
    "publicSequence": [
      "Discovery",
      "Registry",
      "RRIP Resolution",
      "Resource Selection",
      "Availability Check"
    ],
    "afterAvailabilityCheck": {
      "publicResource": "free retrieval where exposed",
      "registeredProtectedResource": "x402 flow may apply",
      "unknownResource": "404 without payment challenge",
      "knownIncompleteResource": "409 without payment challenge"
    }
  },

  "canonicalRegistry": {
    "path": "docs/examples/json-ld/canonical-plate-registry.json",
    "registryVersion": "2026.08.19",
    "canonicalPlateCount": 757
  },

  "exampleResolution": {
    "input": "willows-of-north-america#willow-biodiversity-plate",
    "query": "/api/v2/rrip/resolve?id=willows-of-north-america%23willow-biodiversity-plate",
    "resolvedPath": [
      "Willow Biodiversity Plate™",
      "Willows of North America Plates",
      "Naturepedia™"
    ],
    "higherOrderResources": "resolve only when explicitly implemented and registered",
    "paymentRequiredForResolution": false
  },

  "initialQueryExamples": [
    {
      "query": "/api/v2/rrip/resolve?id=willows-of-north-america%23willow-biodiversity-plate",
      "input": "willows-of-north-america#willow-biodiversity-plate",
      "resolvedPath": [
        "Willow Biodiversity Plate™",
        "Willows of North America Plates",
        "Naturepedia™"
      ]
    },
    {
      "query": "/api/v2/rrip/resolve?id=cedars-of-north-america%23cedar-identification-plate",
      "input": "cedars-of-north-america#cedar-identification-plate",
      "resolvedPath": [
        "Cedar Identification Plate™",
        "Cedars of North America Plates",
        "Naturepedia™"
      ]
    },
    {
      "query": "/api/v2/rrip/resolve?id=firs-of-north-america%23fir-carbon-storage-plate",
      "input": "firs-of-north-america#fir-carbon-storage-plate",
      "resolvedPath": [
        "Fir Carbon Storage Plate™",
        "Firs of North America Plates",
        "Naturepedia™"
      ]
    },
    {
      "query": "/api/v2/rrip/resolve?id=hickories-of-north-america%23hickory-biodiversity-plate",
      "input": "hickories-of-north-america#hickory-biodiversity-plate",
      "resolvedPath": [
        "Hickory Biodiversity Plate™",
        "Hickories of North America Plates",
        "Naturepedia™"
      ]
    }
  ],

  "governance": {
    "expression": "Gr <= Es",
    "interpretation": "Framework governance metadata; not an empirical validation claim."
  },

  "commercialBoundary": {
    "rripResolution": "public control-plane operation",
    "x402Retrieval": "applies only to explicitly registered protected resources",
    "commercialDataLicense": "separate rights layer",
    "frameworkLicense": "separate implementation-rights layer",
    "paymentDoesNotGrantTrainingRights": true,
    "paymentDoesNotGrantEmbeddingRights": true,
    "paymentDoesNotGrantRedistributionRights": true,
    "paymentDoesNotGrantFrameworkImplementationRights": true
  },

  "relatedEndpoints": {
    "discovery": "/api/v2/naturepedia/index.md",
    "registry": "/api/v2/plates/registry.md",
    "stateValidation": "/api/v2/razor/state-token"
  },

  "futureCapabilities": [
    "Dynamic registry lookup",
    "Registry lineage inspection",
    "Expanded relationship resolution",
    "Machine-readable provenance tracing",
    "Explicit Graph Registry traversal where implemented",
    "Explicit Knowledge Mesh traversal where implemented",
    "MCP-compatible registry navigation"
  ],

  "status": {
    "rrip": "active",
    "controlPlane": "public",
    "resolutionMode": "registered-object-resolution",
    "higherOrderResources": "resource-specific",
    "x402ProtectedRetrieval": "resource-specific"
  }
}
